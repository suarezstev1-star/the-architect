{
  "name": "pulso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "dev": "pnpm --parallel --filter @pulso/server --filter @pulso/web dev",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-pulso",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm test:unit && pnpm test:emu",
    "test:unit": "vitest run --project shared --project server --project web",
    "test:emu": "firebase emulators:exec --only auth,firestore,storage --project demo-pulso \"vitest run --project emulator\"",
    "test:coverage": "vitest run --coverage --project shared",
    "test:e2e": "playwright test --project=ui",
    "test:e2e:full": "E2E_FULL=1 playwright test",
    "eval": "tsx --env-file=.env.example --tsconfig apps/server/tsconfig.json apps/server/evals/run.ts",
    "eval:live": "tsx --tsconfig apps/server/tsconfig.json apps/server/evals/run.ts --live",
    "spike:stt": "tsx --tsconfig apps/server/tsconfig.json apps/server/scripts/spike-stt.ts",
    "smoke:server": "node scripts/smoke-server.mjs",
    "check:tokens": "node scripts/check-no-hex.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:budget": "node deploy/check-bundle-budget.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
