# Copy to .env for local development (cp .env.example .env). Every value below is safe to commit:
# local emulator values only. Real Google Cloud settings go in the Cloud Run / Hosting config.

# ---- server: base (step 1) ----
NODE_ENV=development
PORT=8787
GIT_SHA=dev
LOG_LEVEL=info

# ---- server: data and auth (step 3-4) ----
GOOGLE_CLOUD_PROJECT=demo-pulso
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
ALLOWED_EMAILS=dev@pulso.test,e2e@pulso.test
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- server: speech-to-text (step 11) ----
STT_MODEL=long
STT_LOCATION=us
STT_LANGUAGE=es-US
STT_DAILY_SECONDS_PER_ORG=1800
STT_PRICE_USD_PER_MIN=0.016

# ---- server: audio retention (step 12) ----
STORAGE_BUCKET=demo-pulso.appspot.com
SWEEP_AUDIENCE=http://127.0.0.1:8787
SCHEDULER_SA_EMAIL=scheduler@demo-pulso.iam.gserviceaccount.com

# ---- server: Gemini (step 13) ----
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LOCATION=global
GEMINI_TIMEOUT_MS=30000
FILLERS_FROM_AUDIO=true

# ---- documentation only: Google Cloud trial credits expiry (set the real date in the manual gate) ----
CREDITS_EXPIRY_DATE=

# ---- web (read by Vite from the repo root; step 4+) ----
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pulso.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-pulso
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_EMULATORS=true
VITE_API_URL=
VITE_WS_URL=
