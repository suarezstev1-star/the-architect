rules_version = '2';

// Every write goes through the server (Admin SDK bypasses rules). The browser may only READ,
// and only inside an organization it is a member of. Anything not matched is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      allow write: if false;

      match /{document=**} {
        allow read: if isMember(orgId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
